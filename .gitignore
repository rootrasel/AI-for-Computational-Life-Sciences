# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & builds
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & Conda
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# PyTest & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Deep Learning weights, checkpoints, logs
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.h5
*.pb
wandb/
runs/
lightning_logs/
.tensorboard/

# Biological Data Files (Large files / Raw sequencing data)
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.csi
*.vcf.gz
*.vcf.gz.tbi
*.bed.gz
*.bigWig
*.bw
*.h5ad
*.zarr
*.mzML
*.raw
*.tar.gz
*.tar
*.zip

# Ignore raw data contents across all modules
**/data/raw/*
!**/data/raw/.gitkeep
!**/data/raw/.gitignore
**/data/interim/*
!**/data/interim/.gitkeep

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
